(footprint "LiPo_606090"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "606090 LiPo pouch cell (6 x 60 x 90 mm) behind the PCB, 3D model only. Model turned 180 so that, on the flipped (back) footprint, the PCM end and leads face J1.")
	(property "Reference" "BT1"
		(at 0 -31.5 0)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "LiPo 606090"
		(at 0 0 0)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(attr board_only exclude_from_pos_files exclude_from_bom)
	(fp_rect (start -45 -30) (end 45 30) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_text user "PCM / leads" (at -40 0 90) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(model "${KIPRJMOD}/libraries/F1GameStation.3dshapes/LiPo_606090.step"
		(offset (xyz 0 0 2.5))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 180))
	)
)
