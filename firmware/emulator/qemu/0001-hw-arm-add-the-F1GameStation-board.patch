+/* ------------------------------------------------------------------ */
+/* Sound: normal DMA channel 0 -> audio codec DAC -> host audio        */
+/* ------------------------------------------------------------------ */
+
+#define TYPE_F1GS_AUDIO "f1gs-audio"
+OBJECT_DECLARE_SIMPLE_TYPE(F1gsAudioState, F1GS_AUDIO)
+
+struct F1gsAudioState {
+    SysBusDevice parent_obj;
+    MemoryRegion dma_mem;
+    MemoryRegion codec_mem;
+    qemu_irq irq;
+    QEMUSoundCard card;
+    SWVoiceOut *voice;
+    SunivCcuState *ccu;
+    int rate;
+    uint32_t dma[0x200 / 4];
+    uint32_t codec[0x100 / 4];
+    bool running;
+    uint32_t src, count, pos;
+    uint8_t buf[4096];
+};
+
+#define NDMA0_CFG  (0x100 / 4)
+#define NDMA0_SRC  (0x104 / 4)
+#define NDMA0_DST  (0x108 / 4)
+#define NDMA0_CNT  (0x10c / 4)
+
+static void f1gs_audio_irq_update(F1gsAudioState *s)
+{
+    qemu_set_irq(s->irq, !!(s->dma[0] & s->dma[1]));
+}
+
+static int f1gs_audio_rate(F1gsAudioState *s)
+{
+    static const int r48[8] = { 48000, 32000, 24000, 16000,
+                                12000, 8000, 192000, 96000 };
+    static const int r44[8] = { 44100, 32000, 22050, 16000,
+                                11025, 8000, 192000, 96000 };
+    int idx = s->codec[1] >> 29;
+    /* the driver picks PLL_AUDIO 0x90003f10 for the 44.1 kHz family */
+    bool f44 = s->ccu && (s->ccu->regs[0x008 / 4] & 0xffff) == 0x3f10;
+
+    return f44 ? r44[idx] : r48[idx];
+}
+
+static void f1gs_audio_volume(F1gsAudioState *s)
+{
+    int vol = (s->codec[0x20 / 4] & 0x3f) * 255 / 63;
+
+    if (s->voice) {
+        AUD_set_volume_out(s->voice, vol == 0, vol, vol);
+    }
+}
+
+static void f1gs_audio_out(void *opaque, int free);
+
+static void f1gs_audio_open(F1gsAudioState *s)
+{
+    struct audsettings as = {
+        .freq = f1gs_audio_rate(s),
+        .nchannels = 2,
+        .fmt = AUDIO_FORMAT_S16,
+        .endianness = 0,
+    };
+
+    if (!s->voice || as.freq != s->rate) {
+        s->rate = as.freq;
+        s->voice = AUD_open_out(&s->card, s->voice, "f1gs.dac", s,
+                                f1gs_audio_out, &as);
+        f1gs_audio_volume(s);
+    }
+}
+
+static void f1gs_audio_done(F1gsAudioState *s)
+{
+    s->running = false;
+    s->dma[NDMA0_CFG] &= ~(1u << 31);
+    s->dma[1] |= 2;                     /* NDMA0 full transfer */
+    f1gs_audio_irq_update(s);
+}
+
+static void f1gs_audio_out(void *opaque, int free)
+{
+    F1gsAudioState *s = opaque;
+
+    while (s->running && free > 0) {
+        int n = MIN(MIN(free, (int)sizeof(s->buf)), s->count - s->pos);
+        int done;
+
+        dma_memory_read(&address_space_memory, s->src + s->pos, s->buf, n,
+                        MEMTXATTRS_UNSPECIFIED);
+        done = AUD_write(s->voice, s->buf, n);
+        if (s->pos < s->count / 2 && s->pos + done >= s->count / 2) {
+            s->dma[1] |= 1;             /* NDMA0 half transfer */
+            f1gs_audio_irq_update(s);
+        }
+        s->pos += done;
+        free -= done;
+        if (s->pos >= s->count) {
+            f1gs_audio_done(s);
+        }
+        if (done < n) {
+            break;
+        }
+    }
+}
+
+static void f1gs_audio_start(F1gsAudioState *s)
+{
+    s->src = s->dma[NDMA0_SRC];
+    s->count = s->dma[NDMA0_CNT] & 0x1ffff;
+    s->pos = 0;
+    if (!s->count) {
+        f1gs_audio_done(s);
+        return;
+    }
+    s->running = true;
+    f1gs_audio_open(s);
+    if (s->voice) {
+        AUD_set_active_out(s->voice, 1);
+    }
+}
+
+static uint64_t f1gs_dma_read(void *opaque, hwaddr off, unsigned size)
+{
+    F1gsAudioState *s = opaque;
+
+    return off < sizeof(s->dma) ? s->dma[off / 4] : 0;
+}
+
+static void f1gs_dma_write(void *opaque, hwaddr off, uint64_t val,
+                           unsigned size)
+{
+    F1gsAudioState *s = opaque;
+
+    if (off >= sizeof(s->dma)) {
+        return;
+    }
+    switch (off / 4) {
+    case 1:
+        s->dma[1] &= ~val;
+        break;
+    case NDMA0_CFG:
+        s->dma[NDMA0_CFG] = val;
+        if ((val & (1u << 31)) && !s->running) {
+            f1gs_audio_start(s);
+        } else if (!(val & (1u << 31))) {
+            s->running = false;
+        }
+        break;
+    default:
+        s->dma[off / 4] = val;
+        break;
+    }
+    f1gs_audio_irq_update(s);
+}
+
+static uint64_t f1gs_codec_read(void *opaque, hwaddr off, unsigned size)
+{
+    F1gsAudioState *s = opaque;
+
+    if (off == 0x08) {
+        return 0x00800008 | (0x80 << 8);  /* TX FIFO empty, room to write */
+    }
+    return off < sizeof(s->codec) ? s->codec[off / 4] : 0;
+}
+
+static void f1gs_codec_write(void *opaque, hwaddr off, uint64_t val,
+                             unsigned size)
+{
+    F1gsAudioState *s = opaque;
+
+    if (off < sizeof(s->codec)) {
+        s->codec[off / 4] = val;
+    }
+    if (off == 0x20) {
+        f1gs_audio_volume(s);
+    }
+}
+
+static const MemoryRegionOps f1gs_dma_ops = {
+    .read = f1gs_dma_read, .write = f1gs_dma_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4, .valid.max_access_size = 4,
+};
+static const MemoryRegionOps f1gs_codec_ops = {
+    .read = f1gs_codec_read, .write = f1gs_codec_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4, .valid.max_access_size = 4,
+};
+
+static void f1gs_audio_init(Object *obj)
+{
+    F1gsAudioState *s = F1GS_AUDIO(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->dma_mem, obj, &f1gs_dma_ops, s,
+                          "suniv-dma", 0x1000);
+    memory_region_init_io(&s->codec_mem, obj, &f1gs_codec_ops, s,
+                          "suniv-codec", 0x400);
+    sysbus_init_mmio(sbd, &s->dma_mem);
+    sysbus_init_mmio(sbd, &s->codec_mem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static void f1gs_audio_realize(DeviceState *dev, Error **errp)
+{
+    F1gsAudioState *s = F1GS_AUDIO(dev);
+
+    if (!AUD_register_card("f1gs", &s->card, errp)) {
+        return;
+    }
+    f1gs_audio_open(s);
+}
+
+static void f1gs_audio_reset(DeviceState *dev)
+{
+    F1gsAudioState *s = F1GS_AUDIO(dev);
+
+    memset(s->dma, 0, sizeof(s->dma));
+    memset(s->codec, 0, sizeof(s->codec));
+    s->running = false;
+    if (s->voice) {
+        AUD_set_active_out(s->voice, 0);
+    }
+}
+
+static Property f1gs_audio_props[] = {
+    DEFINE_AUDIO_PROPERTIES(F1gsAudioState, card),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void f1gs_audio_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = f1gs_audio_realize;
+    device_class_set_legacy_reset(dc, f1gs_audio_reset);
+    device_class_set_props(dc, f1gs_audio_props);
+}
