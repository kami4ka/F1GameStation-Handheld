+/* ------------------------------------------------------------------ */
+/* Interrupt controller ("allwinner,suniv-f1c100s-ic")                 */
+/* ------------------------------------------------------------------ */
+
+#define TYPE_SUNIV_INTC "suniv-intc"
+OBJECT_DECLARE_SIMPLE_TYPE(SunivIntcState, SUNIV_INTC)
+
+#define SUNIV_INTC_NR 64
+
+struct SunivIntcState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq parent_irq;
+    qemu_irq parent_fiq;
+    uint32_t level[2];
+    uint32_t enable[2];
+    uint32_t mask[2];
+    uint32_t base_addr;
+    uint32_t protect;
+    uint32_t nmi;
+    uint32_t vector;
+};
+
+static void suniv_intc_update(SunivIntcState *s)
+{
+    int i, irq = 0;
+
+    s->vector = 0;
+    for (i = 0; i < 2; i++) {
+        uint32_t act = s->level[i] & s->enable[i] & ~s->mask[i];
+        if (act) {
+            if (!irq) {
+                s->vector = (i * 32 + ctz32(act)) * 4;
+            }
+            irq = 1;
+        }
+    }
+    qemu_set_irq(s->parent_irq, irq);
+}
+
+static void suniv_intc_set_irq(void *opaque, int n, int level)
+{
+    SunivIntcState *s = opaque;
+
+    s->level[n / 32] = deposit32(s->level[n / 32], n % 32, 1, !!level);
+    suniv_intc_update(s);
+}
+
+static uint64_t suniv_intc_read(void *opaque, hwaddr off, unsigned size)
+{
+    SunivIntcState *s = opaque;
+    int i = (off >> 2) & 1;
+
+    switch (off) {
+    case 0x00:
+        return s->base_addr + s->vector;
+    case 0x04:
+        return s->base_addr;
+    case 0x08:
+        return s->protect;
+    case 0x0c:
+        return s->nmi;
+    case 0x10: case 0x14:
+        return s->level[i];
+    case 0x20: case 0x24:
+        return s->enable[i];
+    case 0x30: case 0x34:
+        return s->mask[i];
+    default:
+        return 0;
+    }
+}
+
+static void suniv_intc_write(void *opaque, hwaddr off, uint64_t val,
+                             unsigned size)
+{
+    SunivIntcState *s = opaque;
+    int i = (off >> 2) & 1;
+
+    switch (off) {
+    case 0x04:
+        s->base_addr = val & ~3;
+        break;
+    case 0x08:
+        s->protect = val;
+        break;
+    case 0x0c:
+        s->nmi = val;
+        break;
+    case 0x20: case 0x24:
+        s->enable[i] = val;
+        break;
+    case 0x30: case 0x34:
+        s->mask[i] = val;
+        break;
+    default:
+        /* pending bits follow the (level) sources; writes are acks */
+        break;
+    }
+    suniv_intc_update(s);
+}
+
+static const MemoryRegionOps suniv_intc_ops = {
+    .read = suniv_intc_read,
+    .write = suniv_intc_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void suniv_intc_init(Object *obj)
+{
+    SunivIntcState *s = SUNIV_INTC(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    qdev_init_gpio_in(DEVICE(obj), suniv_intc_set_irq, SUNIV_INTC_NR);
+    sysbus_init_irq(sbd, &s->parent_irq);
+    sysbus_init_irq(sbd, &s->parent_fiq);
+    memory_region_init_io(&s->iomem, obj, &suniv_intc_ops, s,
+                          TYPE_SUNIV_INTC, 0x400);
+    sysbus_init_mmio(sbd, &s->iomem);
+}
+
+static void suniv_intc_reset(DeviceState *dev)
+{
+    SunivIntcState *s = SUNIV_INTC(dev);
+
+    s->enable[0] = s->enable[1] = 0;
+    s->mask[0] = s->mask[1] = 0;
+    s->base_addr = s->protect = s->nmi = 0;
+    suniv_intc_update(s);
+}
+
+static void suniv_intc_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, suniv_intc_reset);
+}
+
+/* ------------------------------------------------------------------ */
+/* CCU: plain registers; PLL lock (bit 28) always reads as set         */
+/* ------------------------------------------------------------------ */
+
+#define TYPE_SUNIV_CCU "suniv-ccu"
+OBJECT_DECLARE_SIMPLE_TYPE(SunivCcuState, SUNIV_CCU)
+
+struct SunivCcuState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t regs[0x400 / 4];
+};
+
+static uint64_t suniv_ccu_read(void *opaque, hwaddr off, unsigned size)
+{
+    SunivCcuState *s = opaque;
+    uint32_t v = s->regs[off / 4];
+
+    if (off <= 0x2c) {
+        v |= 1u << 28;          /* PLL_x_CTRL: LOCK */
+    }
+    return v;
+}
+
+static void suniv_ccu_write(void *opaque, hwaddr off, uint64_t val,
+                            unsigned size)
+{
+    SunivCcuState *s = opaque;
+
+    s->regs[off / 4] = val;
+}
+
+static const MemoryRegionOps suniv_ccu_ops = {
+    .read = suniv_ccu_read,
+    .write = suniv_ccu_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void suniv_ccu_reset(DeviceState *dev)
+{
+    SunivCcuState *s = SUNIV_CCU(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    /* state after the board's U-Boot, which this machine skips */
+    s->regs[0x000 / 4] = 0x80001410;    /* PLL_CPU 408 MHz */
+    s->regs[0x008 / 4] = 0x00035514;    /* PLL_AUDIO */
+    s->regs[0x010 / 4] = 0x03006207;    /* PLL_VIDEO */
+    s->regs[0x018 / 4] = 0x03006207;    /* PLL_VE */
+    s->regs[0x020 / 4] = 0x80101800;    /* PLL_DDR */
+    s->regs[0x028 / 4] = 0x80041800;    /* PLL_PERIPH 600 MHz */
+    s->regs[0x050 / 4] = 0x00020000;    /* CPU_CLK_SRC = PLL_CPU */
+    s->regs[0x054 / 4] = 0x00003180;    /* AHB/APB/HCLKC */
+    s->regs[0x060 / 4] = 0x00004000;    /* BUS_CLK_GATING0 (MMC0) */
+    s->regs[0x068 / 4] = 0x00100000;    /* BUS_CLK_GATING2 (UART0) */
+    s->regs[0x2c0 / 4] = 0x00004000;    /* BUS_SOFT_RST0 */
+    s->regs[0x2d0 / 4] = 0x00100000;    /* BUS_SOFT_RST2 */
+}
+
+static void suniv_ccu_init(Object *obj)
+{
+    SunivCcuState *s = SUNIV_CCU(obj);
+
+    memory_region_init_io(&s->iomem, obj, &suniv_ccu_ops, s,
+                          TYPE_SUNIV_CCU, 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static void suniv_ccu_class_init(ObjectClass *klass, void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), suniv_ccu_reset);
+}
+
+/* ------------------------------------------------------------------ */
+/* Watchdog ("allwinner,sun6i-a31-wdt"): used by Linux for reboot      */
+/* ------------------------------------------------------------------ */
+
+#define TYPE_SUNIV_WDT "suniv-wdt"
+OBJECT_DECLARE_SIMPLE_TYPE(SunivWdtState, SUNIV_WDT)
+
+struct SunivWdtState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    uint32_t irq_en, irq_sta, ctrl, cfg, mode;
+};
+
+static const uint16_t suniv_wdt_ms[16] = {
+    500, 1000, 2000, 3000, 4000, 5000, 6000, 8000,
+    10000, 12000, 14000, 16000, 16000, 16000, 16000, 16000,
+};
+
+static void suniv_wdt_kick(SunivWdtState *s)
+{
+    if (s->mode & 1) {
+        timer_mod(s->timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                  suniv_wdt_ms[(s->mode >> 4) & 0xf]);
+    } else {
+        timer_del(s->timer);
+    }
+}
+
+static void suniv_wdt_expired(void *opaque)
+{
+    SunivWdtState *s = opaque;
+
+    if ((s->cfg & 3) == 1) {
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+}
+
+static uint64_t suniv_wdt_read(void *opaque, hwaddr off, unsigned size)
+{
+    SunivWdtState *s = opaque;
+
+    switch (off) {
+    case 0x00: return s->irq_en;
+    case 0x04: return s->irq_sta;
+    case 0x10: return s->ctrl;
+    case 0x14: return s->cfg;
+    case 0x18: return s->mode;
+    default:   return 0;
+    }
+}
+
+static void suniv_wdt_write(void *opaque, hwaddr off, uint64_t val,
+                            unsigned size)
+{
+    SunivWdtState *s = opaque;
+
+    switch (off) {
+    case 0x00:
+        s->irq_en = val;
+        break;
+    case 0x04:
+        s->irq_sta &= ~val;
+        break;
+    case 0x10:
+        if ((val & 1) && ((val >> 1) & 0xfff) == 0xa57) {
+            suniv_wdt_kick(s);
+        }
+        break;
+    case 0x14:
+        s->cfg = val;
+        break;
+    case 0x18:
+        /* Linux's restart path keeps rewriting MODE: only an enable or a
+         * new interval (re)starts the countdown, like the hardware */
+        if ((val ^ s->mode) & 0xf1) {
+            s->mode = val;
+            suniv_wdt_kick(s);
+        }
+        s->mode = val;
+        break;
+    }
+}
+
+static const MemoryRegionOps suniv_wdt_ops = {
+    .read = suniv_wdt_read,
+    .write = suniv_wdt_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+};
+
+static void suniv_wdt_init(Object *obj)
+{
+    SunivWdtState *s = SUNIV_WDT(obj);
+
+    memory_region_init_io(&s->iomem, obj, &suniv_wdt_ops, s,
+                          TYPE_SUNIV_WDT, 0x20);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, suniv_wdt_expired, s);
+}
+
+static void suniv_wdt_reset(DeviceState *dev)
+{
+    SunivWdtState *s = SUNIV_WDT(dev);
+
+    s->irq_en = s->irq_sta = s->ctrl = s->mode = 0;
+    s->cfg = 1;
+    timer_del(s->timer);
+}
+
+static void suniv_wdt_class_init(ObjectClass *klass, void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), suniv_wdt_reset);
+}
+
+
+/* ------------------------------------------------------------------ */
+/* PIO, with the 13 buttons on the host keyboard                       */
+/* ------------------------------------------------------------------ */
+
+#define TYPE_SUNIV_PIO "suniv-pio"
+OBJECT_DECLARE_SIMPLE_TYPE(SunivPioState, SUNIV_PIO)
+
+enum { PORT_A, PORT_B, PORT_C, PORT_D, PORT_E, PORT_F, PIO_PORTS };
+
+typedef struct F1gsButton {
+    const char *name;
+    int port;
+    int pin;
+    int qcode[3];   /* host keys, 0-terminated */
+} F1gsButton;
+
+/* Pins from the F1GameStation schematic; every button switches to GND. */
+static const F1gsButton f1gs_buttons[] = {
+    { "UP",     PORT_E, 10, { Q_KEY_CODE_UP } },
+    { "DOWN",   PORT_E, 11, { Q_KEY_CODE_DOWN } },
+    { "LEFT",   PORT_E,  4, { Q_KEY_CODE_LEFT } },
+    { "RIGHT",  PORT_E,  5, { Q_KEY_CODE_RIGHT } },
+    { "A",      PORT_E,  7, { Q_KEY_CODE_X } },
+    { "B",      PORT_E,  8, { Q_KEY_CODE_Z } },
+    { "X",      PORT_E,  9, { Q_KEY_CODE_S } },
+    { "Y",      PORT_D, 12, { Q_KEY_CODE_A } },
+    { "START",  PORT_E, 12, { Q_KEY_CODE_RET } },
+    { "SELECT", PORT_D,  0, { Q_KEY_CODE_SHIFT_R, Q_KEY_CODE_BACKSPACE } },
+    { "MENU",   PORT_A,  1, { Q_KEY_CODE_ESC, Q_KEY_CODE_M } },
+    { "L",      PORT_A,  2, { Q_KEY_CODE_Q } },
+    { "R",      PORT_A,  3, { Q_KEY_CODE_W } },
+};
+
+struct SunivPioState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    QemuInputHandlerState *input;
+    uint32_t regs[0x400 / 4];
+    uint32_t buttons[PIO_PORTS];   /* pins that have a button */
+    uint32_t pressed[PIO_PORTS];   /* buttons held now */
+};
+
+static uint64_t suniv_pio_read(void *opaque, hwaddr off, unsigned size)
+{
+    SunivPioState *s = opaque;
+    unsigned port = off / 0x24;
+
+    if (port < PIO_PORTS && off % 0x24 == 0x10) {
+        /*
+         * Button pins have pull-ups to 3.3 V: they read 1 unless the
+         * button is held, whatever the pin mode (this also satisfies the
+         * charge-then-sense reads used on PA1-PA3).
+         */
+        return (s->regs[off / 4] | s->buttons[port]) & ~s->pressed[port];
+    }
+    return s->regs[off / 4];
+}
+
+static void suniv_pio_write(void *opaque, hwaddr off, uint64_t val,
+                            unsigned size)
+{
+    SunivPioState *s = opaque;
+
+    s->regs[off / 4] = val;
+}
+
+static const MemoryRegionOps suniv_pio_ops = {
+    .read = suniv_pio_read,
+    .write = suniv_pio_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void suniv_pio_key(DeviceState *dev, QemuConsole *src, InputEvent *evt)
+{
+    SunivPioState *s = SUNIV_PIO(dev);
+    InputKeyEvent *key = evt->u.key.data;
+    int qcode = qemu_input_key_value_to_qcode(key->key);
+
+    for (size_t i = 0; i < ARRAY_SIZE(f1gs_buttons); i++) {
+        const F1gsButton *b = &f1gs_buttons[i];
+        for (int k = 0; k < 3 && b->qcode[k]; k++) {
+            if (b->qcode[k] == qcode) {
+                s->pressed[b->port] = deposit32(s->pressed[b->port],
+                                                b->pin, 1, key->down);
+            }
+        }
+    }
+}
+
+static const QemuInputHandler suniv_pio_input = {
+    .name  = "F1GameStation buttons",
+    .mask  = INPUT_EVENT_MASK_KEY,
+    .event = suniv_pio_key,
+};
+
+static void suniv_pio_realize(DeviceState *dev, Error **errp)
+{
+    SunivPioState *s = SUNIV_PIO(dev);
+
+    for (size_t i = 0; i < ARRAY_SIZE(f1gs_buttons); i++) {
+        s->buttons[f1gs_buttons[i].port] |= 1u << f1gs_buttons[i].pin;
+    }
+    s->input = qemu_input_handler_register(dev, &suniv_pio_input);
+    qemu_input_handler_activate(s->input);
+}
+
+static void suniv_pio_init(Object *obj)
+{
+    SunivPioState *s = SUNIV_PIO(obj);
+
+    memory_region_init_io(&s->iomem, obj, &suniv_pio_ops, s,
+                          TYPE_SUNIV_PIO, 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static void suniv_pio_reset(DeviceState *dev)
+{
+    SunivPioState *s = SUNIV_PIO(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    /* U-Boot leaves UART0 on PE0/PE1 (function 5) */
+    s->regs[(PORT_E * 0x24) / 4] = 0x77777755;
+}
+
+static void suniv_pio_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = suniv_pio_realize;
+    device_class_set_legacy_reset(dc, suniv_pio_reset);
+}
+
+/* ------------------------------------------------------------------ */
+/* LRADC (KEYADC): the battery voltage through the 200k/100k divider   */
+/* ------------------------------------------------------------------ */
+
+#define TYPE_SUNIV_LRADC "suniv-lradc"
+OBJECT_DECLARE_SIMPLE_TYPE(SunivLradcState, SUNIV_LRADC)
+
+struct SunivLradcState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t regs[0x400 / 4];
+    uint32_t battery_mv;
+};
+
+static uint64_t suniv_lradc_read(void *opaque, hwaddr off, unsigned size)
+{
+    SunivLradcState *s = opaque;
+
+    if (off == 0x0c) {
+        /* 6-bit sample; MiyooCFW's miyoo-battery reports sample * 90 mV */
+        return MIN(s->battery_mv / 90, 63);
+    }
+    return s->regs[off / 4];
+}
+
+static void suniv_lradc_write(void *opaque, hwaddr off, uint64_t val,
+                              unsigned size)
+{
+    SunivLradcState *s = opaque;
+
+    s->regs[off / 4] = val;
+}
+
+static const MemoryRegionOps suniv_lradc_ops = {
+    .read = suniv_lradc_read,
+    .write = suniv_lradc_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void suniv_lradc_init(Object *obj)
+{
+    SunivLradcState *s = SUNIV_LRADC(obj);
+
+    memory_region_init_io(&s->iomem, obj, &suniv_lradc_ops, s,
+                          TYPE_SUNIV_LRADC, 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static Property suniv_lradc_props[] = {
+    DEFINE_PROP_UINT32("battery-mv", SunivLradcState, battery_mv, 3900),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void suniv_lradc_class_init(ObjectClass *klass, void *data)
+{
+    device_class_set_props(DEVICE_CLASS(klass), suniv_lradc_props);
+}
