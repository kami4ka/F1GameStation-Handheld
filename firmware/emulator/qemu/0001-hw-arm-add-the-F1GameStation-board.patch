+        .class_init = suniv_ccu_class_init,
+    }, {
+        .name = TYPE_SUNIV_WDT, .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(SunivWdtState),
+        .instance_init = suniv_wdt_init,
+        .class_init = suniv_wdt_class_init,
+    }, {
+        .name = TYPE_SUNIV_PIO, .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(SunivPioState),
+        .instance_init = suniv_pio_init,
+        .class_init = suniv_pio_class_init,
+    }, {
+        .name = TYPE_SUNIV_LRADC, .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(SunivLradcState),
+        .instance_init = suniv_lradc_init,
+        .class_init = suniv_lradc_class_init,
+    }, {
+        .name = TYPE_F1GS_LCD, .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(F1gsLcdState),
+        .instance_init = f1gs_lcd_init,
+        .class_init = f1gs_lcd_class_init,
+    }, {
+        .name = TYPE_F1GS_AUDIO, .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(F1gsAudioState),
+        .instance_init = f1gs_audio_init,
+        .class_init = f1gs_audio_class_init,
+    }, {
+        .name = TYPE_F1GS_MACHINE, .parent = TYPE_MACHINE,
+        .instance_size = sizeof(F1gsMachineState),
+        .instance_init = f1gs_machine_instance_init,
+        .class_init = f1gs_machine_class_init,
+    },
+};
