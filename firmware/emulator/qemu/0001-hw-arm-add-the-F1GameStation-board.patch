+/* ------------------------------------------------------------------ */
+/* Display: DEBE layer 0 -> TCON0 -> 480x272 panel, PWM1 backlight     */
+/* ------------------------------------------------------------------ */
+
+#define TYPE_F1GS_LCD "f1gs-lcd"
+OBJECT_DECLARE_SIMPLE_TYPE(F1gsLcdState, F1GS_LCD)
+
+struct F1gsLcdState {
+    SysBusDevice parent_obj;
+    MemoryRegion debe_mem;
+    MemoryRegion tcon_mem;
+    MemoryRegion pwm_mem;
+    QemuConsole *con;
+    QEMUTimer *vblank;
+    qemu_irq irq;
+    uint32_t debe[0x1000 / 4];
+    uint32_t tcon[0x1000 / 4];
+    uint32_t pwm[0x10 / 4];
+    uint32_t scale;
+    bool rotate;
+    uint8_t line[PANEL_W * 2 * 4];
+    uint32_t frame[PANEL_W * PANEL_H];
+};
+
+#define VBLANK_NS (NANOSECONDS_PER_SECOND / 58)
+
+static bool f1gs_lcd_enabled(F1gsLcdState *s)
+{
+    return (s->tcon[0x000 / 4] & (1u << 31)) &&
+           (s->tcon[0x040 / 4] & (1u << 31));
+}
+
+static void f1gs_lcd_irq_update(F1gsLcdState *s)
+{
+    uint32_t r = s->tcon[0x004 / 4];
+
+    qemu_set_irq(s->irq, (r & (1u << 31)) && (r & (1u << 15)));
+}
+
+static void f1gs_lcd_vblank(void *opaque)
+{
+    F1gsLcdState *s = opaque;
+
+    if (f1gs_lcd_enabled(s)) {
+        s->tcon[0x004 / 4] |= 1u << 15;
+        f1gs_lcd_irq_update(s);
+    }
+    timer_mod(s->vblank, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + VBLANK_NS);
+}
+
+/* backlight level 0..256 from PWM channel 1 (PE6 drives the boost EN) */
+static int f1gs_lcd_backlight(F1gsLcdState *s)
+{
+    uint32_t ctrl = s->pwm[0] >> 15;
+    uint32_t period = s->pwm[2];
+    uint32_t prd = (period >> 16) + 1, dty = period & 0xffff;
+    int level;
+
+    if (!(ctrl & (1 << 4))) {
+        /* channel never set up: the pull-up keeps the backlight on */
+        return (ctrl & 0x7fff) ? 0 : 256;
+    }
+    level = MIN(dty, prd) * 256 / prd;
+    return (ctrl & (1 << 5)) ? level : 256 - level;
+}
+
+static inline uint32_t f1gs_pixel(const uint8_t *p, int fmt)
+{
+    uint32_t v, r, g, b;
+
+    switch (fmt) {
+    case 0x9:   /* ARGB8888 */
+        return ldl_le_p(p) & 0xffffff;
+    case 0xa:   /* RGB888 */
+        return p[0] | (p[1] << 8) | (p[2] << 16);
+    case 0x7:   /* ARGB1555 */
+        v = lduw_le_p(p);
+        r = (v >> 10) & 0x1f; g = (v >> 5) & 0x1f; b = v & 0x1f;
+        return (r << 19 | (r >> 2) << 16) | (g << 11 | (g >> 2) << 8) |
+               (b << 3 | b >> 2);
+    default:    /* RGB565 */
+        v = lduw_le_p(p);
+        r = (v >> 11) & 0x1f; g = (v >> 5) & 0x3f; b = v & 0x1f;
+        return (r << 19 | (r >> 2) << 16) | (g << 10 | (g >> 4) << 8) |
+               (b << 3 | b >> 2);
+    }
+}
+
+static int f1gs_bpp(int fmt)
+{
+    switch (fmt) {
+    case 0x9: return 4;
+    case 0xa: return 3;
+    default:  return 2;
+    }
+}
+
+static void f1gs_lcd_compose(F1gsLcdState *s)
+{
+    uint32_t mode = s->debe[0x800 / 4];
+    uint32_t size = s->debe[0x810 / 4];
+    uint32_t pos = s->debe[0x820 / 4];
+    uint32_t stride = s->debe[0x840 / 4] / 8;
+    uint64_t addr = (s->debe[0x850 / 4] >> 3) |
+                    ((uint64_t)(s->debe[0x860 / 4] & 0xff) << 29);
+    int fmt = (s->debe[0x8a0 / 4] >> 8) & 0xf;
+    int lw = (size & 0x1fff) + 1, lh = ((size >> 16) & 0x1fff) + 1;
+    int lx = (int16_t)(pos & 0xffff), ly = (int16_t)(pos >> 16);
+    int bpp = f1gs_bpp(fmt);
+    int bl = f1gs_lcd_backlight(s);
+
+    memset(s->frame, 0, sizeof(s->frame));
+    if (!f1gs_lcd_enabled(s) || !(mode & 1) || !(mode & (1 << 8)) || !bl) {
+        return;
+    }
+    for (int y = 0; y < lh; y++) {
+        int py = ly + y, x0 = MAX(0, -lx), x1 = MIN(lw, PANEL_W - lx);
+        if (py < 0 || py >= PANEL_H || x1 <= x0) {
+            continue;
+        }
+        if (dma_memory_read(&address_space_memory,
+                            addr + (uint64_t)y * stride + x0 * bpp,
+                            s->line, (x1 - x0) * bpp,
+                            MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+            continue;
+        }
+        for (int x = x0; x < x1; x++) {
+            uint32_t c = f1gs_pixel(s->line + (x - x0) * bpp, fmt);
+            if (bl < 256) {
+                c = (((c >> 16 & 0xff) * bl >> 8) << 16) |
+                    (((c >> 8 & 0xff) * bl >> 8) << 8) |
+                    ((c & 0xff) * bl >> 8);
+            }
+            s->frame[py * PANEL_W + lx + x] = c;
+        }
+    }
+}
+
+static void f1gs_lcd_update(void *opaque)
+{
+    F1gsLcdState *s = opaque;
+    DisplaySurface *surf = qemu_console_surface(s->con);
+    int sc = s->scale, w = PANEL_W * sc;
+    uint32_t *dst;
+
+    if (surface_width(surf) != w || surface_height(surf) != PANEL_H * sc) {
+        qemu_console_resize(s->con, w, PANEL_H * sc);
+        surf = qemu_console_surface(s->con);
+    }
+    f1gs_lcd_compose(s);
+    dst = (uint32_t *)surface_data(surf);
+    for (int y = 0; y < PANEL_H; y++) {
+        /*
+         * The panel is mounted upside down: the kernel draws each frame
+         * rotated by 180 degrees, so undo that here to show the picture
+         * the way it looks on the handheld.
+         */
+        const uint32_t *src = s->frame +
+            (s->rotate ? (PANEL_H - 1 - y) : y) * PANEL_W;
+        uint32_t *row = dst + y * sc * (surface_stride(surf) / 4);
+        for (int x = 0; x < PANEL_W; x++) {
+            uint32_t c = src[s->rotate ? PANEL_W - 1 - x : x];
+            for (int i = 0; i < sc; i++) {
+                row[x * sc + i] = c;
+            }
+        }
+        for (int i = 1; i < sc; i++) {
+            memcpy(row + i * (surface_stride(surf) / 4), row, w * 4);
+        }
+    }
+    dpy_gfx_update_full(s->con);
+}
+
+static const GraphicHwOps f1gs_lcd_gfx_ops = {
+    .gfx_update = f1gs_lcd_update,
+};
+
+static uint64_t f1gs_debe_read(void *opaque, hwaddr off, unsigned size)
+{
+    return ((F1gsLcdState *)opaque)->debe[(off & 0xfff) / 4];
+}
+
+static void f1gs_debe_write(void *opaque, hwaddr off, uint64_t val,
+                            unsigned size)
+{
+    ((F1gsLcdState *)opaque)->debe[(off & 0xfff) / 4] = val;
+}
+
+static uint64_t f1gs_tcon_read(void *opaque, hwaddr off, unsigned size)
+{
+    return ((F1gsLcdState *)opaque)->tcon[off / 4];
+}
+
+static void f1gs_tcon_write(void *opaque, hwaddr off, uint64_t val,
+                            unsigned size)
+{
+    F1gsLcdState *s = opaque;
+
+    s->tcon[off / 4] = val;
+    if (off == 0x004) {
+        f1gs_lcd_irq_update(s);
+    }
+}
+
+static uint64_t f1gs_pwm_read(void *opaque, hwaddr off, unsigned size)
+{
+    F1gsLcdState *s = opaque;
+
+    return off < sizeof(s->pwm) ? s->pwm[off / 4] : 0;
+}
+
+static void f1gs_pwm_write(void *opaque, hwaddr off, uint64_t val,
+                           unsigned size)
+{
+    F1gsLcdState *s = opaque;
+
+    if (off < sizeof(s->pwm)) {
+        s->pwm[off / 4] = val;
+    }
+}
+
+static const MemoryRegionOps f1gs_debe_ops = {
+    .read = f1gs_debe_read, .write = f1gs_debe_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4, .valid.max_access_size = 4,
+};
+static const MemoryRegionOps f1gs_tcon_ops = {
+    .read = f1gs_tcon_read, .write = f1gs_tcon_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4, .valid.max_access_size = 4,
+};
+static const MemoryRegionOps f1gs_pwm_ops = {
+    .read = f1gs_pwm_read, .write = f1gs_pwm_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4, .valid.max_access_size = 4,
+};
+
+static void f1gs_lcd_init(Object *obj)
+{
+    F1gsLcdState *s = F1GS_LCD(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->debe_mem, obj, &f1gs_debe_ops, s,
+                          "suniv-debe", 0x10000);
+    memory_region_init_io(&s->tcon_mem, obj, &f1gs_tcon_ops, s,
+                          "suniv-tcon", 0x1000);
+    memory_region_init_io(&s->pwm_mem, obj, &f1gs_pwm_ops, s,
+                          "suniv-pwm", 0x400);
+    sysbus_init_mmio(sbd, &s->debe_mem);
+    sysbus_init_mmio(sbd, &s->tcon_mem);
+    sysbus_init_mmio(sbd, &s->pwm_mem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static void f1gs_lcd_realize(DeviceState *dev, Error **errp)
+{
+    F1gsLcdState *s = F1GS_LCD(dev);
+
+    if (s->scale < 1 || s->scale > 4) {
+        error_setg(errp, "scale must be 1 to 4");
+        return;
+    }
+    s->con = graphic_console_init(dev, 0, &f1gs_lcd_gfx_ops, s);
+    qemu_console_resize(s->con, PANEL_W * s->scale, PANEL_H * s->scale);
+    s->vblank = timer_new_ns(QEMU_CLOCK_VIRTUAL, f1gs_lcd_vblank, s);
+}
+
+static void f1gs_lcd_reset(DeviceState *dev)
+{
+    F1gsLcdState *s = F1GS_LCD(dev);
+
+    memset(s->debe, 0, sizeof(s->debe));
+    memset(s->tcon, 0, sizeof(s->tcon));
+    memset(s->pwm, 0, sizeof(s->pwm));
+    timer_mod(s->vblank, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + VBLANK_NS);
+}
+
+static Property f1gs_lcd_props[] = {
+    DEFINE_PROP_UINT32("scale", F1gsLcdState, scale, 2),
+    DEFINE_PROP_BOOL("rotate", F1gsLcdState, rotate, true),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void f1gs_lcd_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = f1gs_lcd_realize;
+    device_class_set_legacy_reset(dc, f1gs_lcd_reset);
+    device_class_set_props(dc, f1gs_lcd_props);
+}
