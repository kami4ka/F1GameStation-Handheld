+/* ------------------------------------------------------------------ */
+/* The board                                                           */
+/* ------------------------------------------------------------------ */
+
+#define TYPE_F1GS_MACHINE MACHINE_TYPE_NAME("f1gamestation")
+OBJECT_DECLARE_SIMPLE_TYPE(F1gsMachineState, F1GS_MACHINE)
+
+struct F1gsMachineState {
+    MachineState parent_obj;
+    uint32_t scale;
+    bool rotate;
+    uint32_t battery_mv;
+};
+
+static struct arm_boot_info f1gs_binfo;
+
+/* Peripherals the emulator does not model: keep their drivers away. */
+static void f1gs_modify_dtb(const struct arm_boot_info *info, void *fdt)
+{
+    static const char * const compat[] = {
+        "allwinner,suniv-f1c100s-spi",
+        "allwinner,suniv-f1c100s-musb",
+        "allwinner,suniv-f1c100s-usb-phy",
+        "allwinner,suniv-f1c100s-cedar",
+    };
+
+    int node;
+
+    /* -drive if=sd,index=1: the second slot (MMC1) is a shared disk */
+    if (drive_get(IF_SD, 1, 0)) {
+        node = fdt_node_offset_by_prop_value(fdt, -1, "reg",
+                                             (const uint32_t[]){
+                                                 cpu_to_be32(F1GS_MMC1_BASE),
+                                                 cpu_to_be32(0x1000) }, 8);
+        if (node >= 0) {
+            fdt_setprop_string(fdt, node, "status", "okay");
+            fdt_setprop_u32(fdt, node, "bus-width", 4);
+            fdt_setprop(fdt, node, "broken-cd", NULL, 0);
+            /* same 3.3 V supply as MMC0, or the core finds no voltages */
+            int mmc0 = fdt_node_offset_by_prop_value(fdt, -1, "reg",
+                                             (const uint32_t[]){
+                                                 cpu_to_be32(F1GS_MMC0_BASE),
+                                                 cpu_to_be32(0x1000) }, 8);
+            int len;
+            const void *vmmc = mmc0 >= 0 ?
+                fdt_getprop(fdt, mmc0, "vmmc-supply", &len) : NULL;
+            if (vmmc) {
+                fdt_setprop(fdt, node, "vmmc-supply", vmmc, len);
+            }
+        }
+    }
+
+    for (size_t i = 0; i < ARRAY_SIZE(compat); i++) {
+        node = -1;
+        while ((node = fdt_node_offset_by_compatible(fdt, node,
+                                                     compat[i])) >= 0) {
+            fdt_setprop_string(fdt, node, "status", "disabled");
+        }
+    }
+}
+
+static DeviceState *f1gs_sysbus(const char *type, hwaddr base, int irq,
+                                DeviceState *intc)
+{
+    DeviceState *dev = qdev_new(type);
+
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+    if (irq >= 0) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                           qdev_get_gpio_in(intc, irq));
+    }
+    return dev;
+}
+
+static void f1gs_init(MachineState *machine)
+{
+    F1gsMachineState *fm = F1GS_MACHINE(machine);
+    MemoryRegion *sysmem = get_system_memory();
+    MemoryRegion *sram_a = g_new(MemoryRegion, 1);
+    MemoryRegion *sram_c = g_new(MemoryRegion, 1);
+    ARMCPU *cpu;
+    DeviceState *intc, *dev, *ccu, *carddev;
+    DriveInfo *di;
+    BlockBackend *blk;
+
+    if (machine->ram_size > 64 * MiB) {
+        error_report("The F1C200s has 64 MiB of DRAM");
+        exit(1);
+    }
+
+    cpu = ARM_CPU(cpu_create(machine->cpu_type));
+    memory_region_add_subregion(sysmem, F1GS_SDRAM_BASE, machine->ram);
+
+    memory_region_init_ram(sram_a, NULL, "f1gs.sram-a", 64 * KiB,
+                           &error_fatal);
+    memory_region_add_subregion(sysmem, 0x00000000, sram_a);
+    memory_region_init_ram(sram_c, NULL, "f1gs.sram-c", 512 * KiB,
+                           &error_fatal);
+    memory_region_add_subregion(sysmem, 0x01d00000, sram_c);
+
+    /* interrupt controller */
+    intc = qdev_new(TYPE_SUNIV_INTC);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(intc), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(intc), 0, F1GS_INTC_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(intc), 0,
+                       qdev_get_gpio_in(DEVICE(cpu), ARM_CPU_IRQ));
+    sysbus_connect_irq(SYS_BUS_DEVICE(intc), 1,
+                       qdev_get_gpio_in(DEVICE(cpu), ARM_CPU_FIQ));
+
+    /* timers: sun4i layout, LOSC 32 kHz and OSC 24 MHz sources */
+    dev = qdev_new(TYPE_AW_A10_PIT);
+    qdev_prop_set_uint32(dev, "clk0-freq", 32768);
+    qdev_prop_set_uint32(dev, "clk1-freq", 24000000);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, F1GS_TIMER_BASE);
+    for (int i = 0; i < 3; i++) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), i,
+                           qdev_get_gpio_in(intc, F1GS_IRQ_TIMER0 + i));
+    }
+    dev = qdev_new(TYPE_SUNIV_WDT);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map_overlap(SYS_BUS_DEVICE(dev), 0, F1GS_WDT_BASE, 1);
+
+    ccu = f1gs_sysbus(TYPE_SUNIV_CCU, F1GS_CCU_BASE, -1, intc);
+    f1gs_sysbus(TYPE_SUNIV_PIO, F1GS_PIO_BASE, -1, intc);
+
+    dev = qdev_new(TYPE_SUNIV_LRADC);
+    qdev_prop_set_uint32(dev, "battery-mv", fm->battery_mv);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, F1GS_LRADC_BASE);
+
+    /* debug UART (8250_dw: the extra registers above 0x1c read as 0) */
+    create_unimplemented_device("uart0-dw", F1GS_UART0_BASE, 0x400);
+    serial_mm_init(sysmem, F1GS_UART0_BASE, 2,
+                   qdev_get_gpio_in(intc, F1GS_IRQ_UART0), 115200,
+                   serial_hd(0), DEVICE_NATIVE_ENDIAN);
+
+    /* SD card slot (MMC0) and the optional shared disk on MMC1 */
+    for (int i = 0; i < 2; i++) {
+        di = drive_get(IF_SD, i, 0);
+        if (i == 1 && !di) {
+            create_unimplemented_device("mmc1", F1GS_MMC1_BASE, 0x1000);
+            break;
+        }
+        dev = qdev_new(TYPE_AW_SDHOST_SUN5I);
+        object_property_set_link(OBJECT(dev), "dma-memory", OBJECT(sysmem),
+                                 &error_fatal);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0,
+                        i ? F1GS_MMC1_BASE : F1GS_MMC0_BASE);
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                           qdev_get_gpio_in(intc, F1GS_IRQ_MMC0 + i));
+        blk = di ? blk_by_legacy_dinfo(di) : NULL;
+        carddev = qdev_new(TYPE_SD_CARD);
+        qdev_prop_set_drive_err(carddev, "drive", blk, &error_fatal);
+        qdev_realize_and_unref(carddev, qdev_get_child_bus(dev, "sd-bus"),
+                               &error_fatal);
+    }
+
+    /* display */
+    dev = qdev_new(TYPE_F1GS_LCD);
+    qdev_prop_set_uint32(dev, "scale", fm->scale);
+    qdev_prop_set_bit(dev, "rotate", fm->rotate);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, F1GS_DEBE_BASE);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 1, F1GS_TCON_BASE);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 2, F1GS_PWM_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                       qdev_get_gpio_in(intc, F1GS_IRQ_TCON));
+
+    /* sound */
+    dev = qdev_new(TYPE_F1GS_AUDIO);
+    F1GS_AUDIO(dev)->ccu = SUNIV_CCU(ccu);
+    if (machine->audiodev) {
+        qdev_prop_set_string(dev, "audiodev", machine->audiodev);
+    }
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, F1GS_DMA_BASE);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 1, F1GS_CODEC_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                       qdev_get_gpio_in(intc, F1GS_IRQ_DMA));
+
+    /* the rest reads as zero */
+    create_unimplemented_device("sram-ctrl", 0x01c00000, 0x1000);
+    create_unimplemented_device("spi0", F1GS_SPI0_BASE, 0x1000);
+    create_unimplemented_device("spi1", F1GS_SPI1_BASE, 0x1000);
+    create_unimplemented_device("tve", F1GS_TVE_BASE, 0x1000);
+    create_unimplemented_device("ve", F1GS_VE_BASE, 0x1000);
+    create_unimplemented_device("usb-otg", F1GS_USB_BASE, 0x1000);
+    create_unimplemented_device("daudio", F1GS_DA_BASE, 0x400);
+    create_unimplemented_device("uart1", 0x01c25400, 0x400);
+    create_unimplemented_device("uart2", 0x01c25800, 0x400);
+    create_unimplemented_device("defe", F1GS_DEFE_BASE, 0x20000);
+
+    f1gs_binfo.loader_start = F1GS_SDRAM_BASE;
+    f1gs_binfo.ram_size = machine->ram_size;
+    f1gs_binfo.board_id = -1;
+    f1gs_binfo.modify_dtb = f1gs_modify_dtb;
+    arm_load_kernel(cpu, machine, &f1gs_binfo);
+}
+
+static void f1gs_get_scale(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &F1GS_MACHINE(obj)->scale, errp);
+}
+
+static void f1gs_set_scale(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &F1GS_MACHINE(obj)->scale, errp);
+}
+
+static void f1gs_get_battery(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &F1GS_MACHINE(obj)->battery_mv, errp);
+}
+
+static void f1gs_set_battery(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &F1GS_MACHINE(obj)->battery_mv, errp);
+}
+
+static bool f1gs_get_rotate(Object *obj, Error **errp)
+{
+    return F1GS_MACHINE(obj)->rotate;
+}
+
+static void f1gs_set_rotate(Object *obj, bool value, Error **errp)
+{
+    F1GS_MACHINE(obj)->rotate = value;
+}
+
+static void f1gs_machine_instance_init(Object *obj)
+{
+    F1gsMachineState *fm = F1GS_MACHINE(obj);
+
+    fm->scale = 2;
+    fm->rotate = true;
+    fm->battery_mv = 3900;
+}
+
+static void f1gs_machine_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "F1GameStation handheld (Allwinner F1C200s, ARM926EJ-S)";
+    mc->init = f1gs_init;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("arm926");
+    mc->default_ram_size = 64 * MiB;
+    mc->default_ram_id = "f1gs.ram";
+    mc->block_default_type = IF_SD;
+    mc->units_per_default_bus = 1;
+    mc->ignore_memory_transaction_failures = true;
+    machine_add_audiodev_property(mc);
+
+    object_class_property_add(oc, "scale", "uint32", f1gs_get_scale,
+                              f1gs_set_scale, NULL, NULL);
+    object_class_property_set_description(oc, "scale",
+        "Window size as a multiple of the 480x272 panel (1-4, default 2)");
+    object_class_property_add_bool(oc, "rotate", f1gs_get_rotate,
+                                   f1gs_set_rotate);
+    object_class_property_set_description(oc, "rotate",
+        "Undo the kernel's 180 degree panel rotation (default on)");
+    object_class_property_add(oc, "battery-mv", "uint32", f1gs_get_battery,
+                              f1gs_set_battery, NULL, NULL);
+    object_class_property_set_description(oc, "battery-mv",
+        "Battery voltage reported on LRADC0 in mV (default 3900)");
+}
+
