+#define F1GS_SDRAM_BASE   0x80000000
+#define F1GS_DMA_BASE     0x01c02000
+#define F1GS_SPI0_BASE    0x01c05000
+#define F1GS_SPI1_BASE    0x01c06000
+#define F1GS_TVE_BASE     0x01c0a000
+#define F1GS_TCON_BASE    0x01c0c000
+#define F1GS_VE_BASE      0x01c0e000
+#define F1GS_MMC0_BASE    0x01c0f000
+#define F1GS_MMC1_BASE    0x01c10000
+#define F1GS_USB_BASE     0x01c13000
+#define F1GS_CCU_BASE     0x01c20000
+#define F1GS_INTC_BASE    0x01c20400
+#define F1GS_PIO_BASE     0x01c20800
+#define F1GS_TIMER_BASE   0x01c20c00
+#define F1GS_WDT_BASE     0x01c20ca0
+#define F1GS_PWM_BASE     0x01c21000
+#define F1GS_DA_BASE      0x01c22000
+#define F1GS_LRADC_BASE   0x01c23400
+#define F1GS_CODEC_BASE   0x01c23c00
+#define F1GS_UART0_BASE   0x01c25000
+#define F1GS_DEFE_BASE    0x01e00000
+#define F1GS_DEBE_BASE    0x01e60000
+
+#define F1GS_IRQ_UART0    1
+#define F1GS_IRQ_TIMER0   13
+#define F1GS_IRQ_DMA      18
+#define F1GS_IRQ_MMC0     23
+#define F1GS_IRQ_TCON     29
+
+#define PANEL_W 480
+#define PANEL_H 272
