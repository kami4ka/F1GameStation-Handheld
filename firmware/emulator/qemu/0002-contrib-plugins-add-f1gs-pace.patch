From 6e8208819263b75272b3bdaa923b564ca354ac05 Mon Sep 17 00:00:00 2001
From: f1gs <f1gs@localhost>
Date: Fri, 13 Nov 2026 22:37:24 +0000
Subject: [PATCH 2/2] contrib/plugins: f1gs-pace, cap guest instructions per
 second

---
 contrib/plugins/f1gs-pace.c | 120 ++++++++++++++++++++++++++++++++++++
 contrib/plugins/meson.build |   3 +-
 2 files changed, 122 insertions(+), 1 deletion(-)
 create mode 100644 contrib/plugins/f1gs-pace.c

diff --git a/contrib/plugins/f1gs-pace.c b/contrib/plugins/f1gs-pace.c
new file mode 100644
index 0000000..631b164
--- /dev/null
+++ b/contrib/plugins/f1gs-pace.c
@@ -0,0 +1,120 @@
+/*
+ * F1GameStation CPU pacing plugin: holds each vCPU to at most N guest
+ * instructions per second of host (wall-clock) time, so software runs about
+ * as fast as on the real F1C200s. Unlike icount or the "ips" plugin, guest
+ * time stays real time: timers, audio and vblank are unaffected, the CPU is
+ * just not allowed to run ahead. Idle time and time the host fell behind
+ * are not banked, so there are no catch-up bursts.
+ *
+ *   -plugin libf1gs-pace.so,ips=500000000
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <stdio.h>
+#include <glib.h>
+#include <qemu-plugin.h>
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+#define NSEC_PER_SEC   1000000000ULL
+#define QUANTA_PER_SEC 500                     /* check every 2 ms */
+#define MAX_BEHIND_NS  (20 * 1000 * 1000)      /* forget lag beyond 20 ms */
+
+typedef struct {
+    uint64_t quantum_insn;  /* counted inline, per TB */
+    uint64_t insn;          /* since start_ns */
+    int64_t start_ns;
+} PaceVcpu;
+
+static struct qemu_plugin_scoreboard *vcpus;
+static uint64_t ips = 500000000;
+static uint64_t quantum;
+
+static int64_t now_ns(void)
+{
+    return g_get_monotonic_time() * 1000;
+}
+
+static void restart(PaceVcpu *v)
+{
+    v->insn = 0;
+    v->start_ns = now_ns();
+}
+
+static void pace(unsigned int cpu_index, void *udata)
+{
+    PaceVcpu *v = qemu_plugin_scoreboard_find(vcpus, cpu_index);
+    int64_t now, due;
+
+    v->insn += v->quantum_insn;
+    v->quantum_insn = 0;
+    due = v->start_ns + (int64_t)((double)v->insn * NSEC_PER_SEC / ips);
+    now = now_ns();
+    if (due > now) {
+        g_usleep((due - now) / 1000);
+    } else if (now - due > MAX_BEHIND_NS) {
+        restart(v);
+    }
+    if (v->insn > ips * 10) {
+        /* keep the arithmetic exact over long runs */
+        restart(v);
+    }
+}
+
+static void vcpu_tb_trans(qemu_plugin_id_t id, struct qemu_plugin_tb *tb)
+{
+    qemu_plugin_u64 q =
+        qemu_plugin_scoreboard_u64_in_struct(vcpus, PaceVcpu, quantum_insn);
+
+    qemu_plugin_register_vcpu_tb_exec_inline_per_vcpu(
+        tb, QEMU_PLUGIN_INLINE_ADD_U64, q, qemu_plugin_tb_n_insns(tb));
+    qemu_plugin_register_vcpu_tb_exec_cond_cb(
+        tb, pace, QEMU_PLUGIN_CB_NO_REGS, QEMU_PLUGIN_COND_GE, q, quantum,
+        NULL);
+}
+
+static void vcpu_init(qemu_plugin_id_t id, unsigned int cpu_index)
+{
+    restart(qemu_plugin_scoreboard_find(vcpus, cpu_index));
+}
+
+static void vcpu_resume(qemu_plugin_id_t id, unsigned int cpu_index)
+{
+    /* the CPU slept (WFI): don't let it make up for the idle time */
+    PaceVcpu *v = qemu_plugin_scoreboard_find(vcpus, cpu_index);
+
+    v->quantum_insn = 0;
+    restart(v);
+}
+
+static void plugin_exit(qemu_plugin_id_t id, void *udata)
+{
+    qemu_plugin_scoreboard_free(vcpus);
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    for (int i = 0; i < argc; i++) {
+        g_auto(GStrv) tok = g_strsplit(argv[i], "=", 2);
+        if (g_strcmp0(tok[0], "ips") == 0 && tok[1]) {
+            ips = g_ascii_strtoull(tok[1], NULL, 10);
+        } else {
+            fprintf(stderr, "f1gs-pace: unknown option %s\n", argv[i]);
+            return -1;
+        }
+    }
+    if (ips < QUANTA_PER_SEC) {
+        fprintf(stderr, "f1gs-pace: ips too small\n");
+        return -1;
+    }
+    quantum = ips / QUANTA_PER_SEC;
+    vcpus = qemu_plugin_scoreboard_new(sizeof(PaceVcpu));
+    qemu_plugin_register_vcpu_tb_trans_cb(id, vcpu_tb_trans);
+    qemu_plugin_register_vcpu_init_cb(id, vcpu_init);
+    qemu_plugin_register_vcpu_resume_cb(id, vcpu_resume);
+    qemu_plugin_register_atexit_cb(id, plugin_exit, NULL);
+    return 0;
+}
diff --git a/contrib/plugins/meson.build b/contrib/plugins/meson.build
index 63a32c2..381a706 100644
--- a/contrib/plugins/meson.build
+++ b/contrib/plugins/meson.build
@@ -1,5 +1,6 @@
 contrib_plugins = ['bbv', 'cache', 'cflow', 'drcov', 'execlog', 'hotblocks',
-                   'hotpages', 'howvec', 'hwprofile', 'ips', 'stoptrigger']
+                   'hotpages', 'howvec', 'hwprofile', 'ips', 'stoptrigger',
+                   'f1gs-pace']
 if host_os != 'windows'
   # lockstep uses socket.h
   contrib_plugins += 'lockstep'
