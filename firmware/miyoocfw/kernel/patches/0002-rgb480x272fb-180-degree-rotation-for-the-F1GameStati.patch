From fc66d3f01fe95e40c559ddf483d784f327082b41 Mon Sep 17 00:00:00 2001
From: Oleg Kulyk <5595029+kami4ka@users.noreply.github.com>
Date: Sat, 31 Oct 2026 16:54:38 +0200
Subject: [PATCH 2/3] rgb480x272fb: 180 degree rotation for the F1GameStation
 panel

The panel has no scan-direction pins and the DEBE cannot rotate, so a
kernel thread copies each frame rotated into one of two scanout buffers
after vsync (about 2.8 ms per frame on the F1C200s). rotate/flip module
parameters and MIYOO_FB0_SET_FLIP switch it at run time; rotate_us in
sysfs reports the copy time.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/video/fbdev/rgb480x272fb.c | 105 ++++++++++++++++++++++++++++-
 1 file changed, 102 insertions(+), 3 deletions(-)

diff --git a/drivers/video/fbdev/rgb480x272fb.c b/drivers/video/fbdev/rgb480x272fb.c
index 50418137f..f32644027 100644
--- a/drivers/video/fbdev/rgb480x272fb.c
+++ b/drivers/video/fbdev/rgb480x272fb.c
@@ -15,6 +15,11 @@
  * software draws a 320x240 RGB565 frame; DEBE layer 0 shows it centred on
  * the 480x272 output with a black border.
  *
+ * The panel has no scan-direction pins and the DEBE cannot rotate, so with
+ * rotate=1 (the default) a kernel thread copies each frame rotated by 180
+ * degrees into one of two scanout buffers after every vsync and flips the
+ * DEBE to it.
+ *
  * Timings were measured on the board during bring-up:
  *   PLL_VIDEO 198 MHz, DCLK = 198 / 22 = 9 MHz,
  *   HT 535, HBP 47, HSPW 4, VT 292, VBP 16, VSPW 4 (~57.6 Hz).
@@ -37,6 +42,8 @@
 #include <linux/delay.h>
 #include <linux/of.h>
 #include <linux/clk-provider.h>
+#include <linux/kthread.h>
+#include <linux/ktime.h>
 #include <asm/io.h>
 #include <asm/arch-suniv/cpu.h>
 #include <asm/arch-suniv/gpio.h>
@@ -50,6 +57,7 @@
 #define MIYOO_FB0_PUT_OSD     _IOWR(0x100, 0, unsigned long)
 #define MIYOO_FB0_SET_MODE    _IOWR(0x101, 0, unsigned long)
 #define MIYOO_FB0_GET_VER     _IOWR(0x102, 0, unsigned long)
+#define MIYOO_FB0_SET_FLIP    _IOWR(0x103, 0, unsigned long)
 
 #define PANEL_W      480
 #define PANEL_H      272
@@ -62,6 +70,12 @@
 static uint32_t version=1;
 module_param(version,uint,0660);
 MODULE_PARM_DESC(version, "Value returned by MIYOO_FB0_GET_VER");
+static bool rotate=true;
+module_param(rotate,bool,0660);
+MODULE_PARM_DESC(rotate, "Rotate the picture by 180 degrees");
+// "flip" is what the other MiyooCFW panel drivers call it
+module_param_named(flip, rotate, bool, 0660);
+MODULE_PARM_DESC(flip, "Same as rotate");
 
 struct myfb_par {
     struct device *dev;
@@ -78,6 +92,13 @@ struct myfb_par {
     int bpp;
     int lcdc_irq;
     uint32_t vsync_count;
+
+    // rotate=1: two scanout buffers filled by rotate_thread
+    void *scan_virt;
+    dma_addr_t scan_phys;
+    int scan_idx;
+    struct task_struct *rotate_task;
+    uint32_t rotate_us;
     u32 pseudo_palette[16];
     struct fb_videomode mode;
 };
@@ -129,16 +150,69 @@ static void suniv_gpio_init(void)
     writel(r, iomm.gpio + PD_CFG2);
 }
 
-static void debe_set_frame(struct myfb_par *par)
+static void debe_set_addr(uint32_t addr)
 {
-    uint32_t addr = par->vram_phys + par->yoffset * FB_LINE;
-
     writel(addr << 3, iomm.debe + DEBE_LAY0_FB_ADDR_REG);
     writel(addr >> 29, iomm.debe + DEBE_LAY0_FB_HI_ADDR_REG);
     // latched by the DEBE at the next frame start
     suniv_setbits(iomm.debe + DEBE_REGBUFF_CTRL_REG, (1 << 0));
 }
 
+static void debe_set_frame(struct myfb_par *par)
+{
+    // when rotating, rotate_thread owns the layer address
+    if(!par->rotate_task){
+        debe_set_addr(par->vram_phys + par->yoffset * FB_LINE);
+    }
+}
+
+// Copy one 320x240 RGB565 frame rotated by 180 degrees. The source is
+// uncached, so each line is read with one burst copy into a cached buffer.
+static void rotate_frame(uint32_t *dst, const uint8_t *src)
+{
+    static uint32_t line[FB_W / 2];
+    int y, x;
+
+    for(y=0; y<FB_H; y++){
+        uint32_t *d = dst + (FB_H - 1 - y) * (FB_W / 2);
+
+        memcpy(line, src + y * FB_LINE, FB_LINE);
+        for(x=0; x<FB_W/2; x++){
+            uint32_t w = line[FB_W / 2 - 1 - x];
+            d[x] = (w >> 16) | (w << 16);
+        }
+    }
+}
+
+static int rotate_thread(void *arg)
+{
+    struct myfb_par *par = arg;
+    uint32_t seen = par->vsync_count;
+    ktime_t t0;
+
+    while(!kthread_should_stop()){
+        wait_event_interruptible_timeout(wait_vsync_queue, seen != par->vsync_count || kthread_should_stop(), HZ / 10);
+        seen = par->vsync_count;
+        if(!rotate){
+            debe_set_addr(par->vram_phys + par->yoffset * FB_LINE);
+            par->rotate_us = 0;
+            continue;
+        }
+        t0 = ktime_get();
+        par->scan_idx^= 1;
+        rotate_frame(par->scan_virt + par->scan_idx * FB_FRAME, par->vram_virt + par->yoffset * FB_LINE);
+        debe_set_addr(par->scan_phys + par->scan_idx * FB_FRAME);
+        par->rotate_us = ktime_us_delta(ktime_get(), t0);
+    }
+    return 0;
+}
+
+static ssize_t rotate_us_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+    return sprintf(buf, "%u\n", mypar ? mypar->rotate_us : 0);
+}
+static DEVICE_ATTR_RO(rotate_us);
+
 static irqreturn_t lcdc_irq_handler(int irq, void *arg)
 {
     struct myfb_par *par = arg;
@@ -425,6 +499,21 @@ static int myfb_probe(struct platform_device *device)
     suniv_cpu_init(par);
     suniv_lcdc_init(par);
     suniv_enable_irq(par);
+    // the thread also runs with rotate=0 so that flip can be turned on later
+    if(par->lcdc_irq >= 0){
+        par->scan_virt = dma_alloc_coherent(par->dev, FB_FRAME * 2, &par->scan_phys, GFP_KERNEL | GFP_DMA);
+        if(par->scan_virt){
+            memset(par->scan_virt, 0, FB_FRAME * 2);
+            par->rotate_task = kthread_run(rotate_thread, par, "rgbfb_rotate");
+            if(IS_ERR(par->rotate_task)){
+                par->rotate_task = NULL;
+            }
+        }
+        if(!par->rotate_task){
+            printk("%s, rotation unavailable, showing the frame unrotated\n", __func__);
+        }
+        device_create_file(&device->dev, &dev_attr_rotate_us);
+    }
 
     myfb_var.activate = FB_ACTIVATE_FORCE;
     fb_set_var(info, &myfb_var);
@@ -444,6 +533,10 @@ static int myfb_remove(struct platform_device *dev)
 
     if(info){
         par = info->par;
+        if(par->rotate_task){
+            kthread_stop(par->rotate_task);
+            device_remove_file(&dev->dev, &dev_attr_rotate_us);
+        }
         suniv_clrbits(iomm.lcdc + TCON_INT_REG0, (1 << 31));
         if(par->lcdc_irq >= 0){
             free_irq(par->lcdc_irq, par);
@@ -453,6 +546,9 @@ static int myfb_remove(struct platform_device *dev)
         fb_dealloc_cmap(&info->cmap);
         dma_free_coherent(par->dev, PALETTE_SIZE, par->v_palette_base, par->p_palette_base);
         dma_free_coherent(par->dev, par->vram_size, par->vram_virt, par->vram_phys);
+        if(par->scan_virt){
+            dma_free_coherent(par->dev, FB_FRAME * 2, par->scan_virt, par->scan_phys);
+        }
         pm_runtime_put_sync(&dev->dev);
         pm_runtime_disable(&dev->dev);
         framebuffer_release(info);
@@ -544,6 +640,9 @@ static long myioctl(struct file *filp, unsigned int cmd, unsigned long arg)
                 writel((7 << 8) | 4, iomm.debe + DEBE_LAY0_ATT_CTRL_REG1);
             }
             break;
+        case MIYOO_FB0_SET_FLIP:
+            rotate = (bool)arg;
+            break;
         case MIYOO_FB0_GET_VER:
             ret = copy_to_user((void*)arg, &version, sizeof(uint32_t));
             break;
-- 
