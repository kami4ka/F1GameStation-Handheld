 //   5 -> V90 meaning additional L2/R2 physical buttons
 //   6 -> Q20 meaning Lfunction/Rfunction button (similarly to Q90)
 //   7 -> HYBRID meaning BittBoy shell with PocketGo components.
+//   8 -> F1GameStation, one GPIO per button (see f1gs_scan)
 
 /* 
  * Hardware map (as observed from the working code)
@@ -128,6 +130,20 @@
 #define IN_PC3  ((32 * 2) + 3)
 #define IN_PA1  ((32 * 0) + 1)
 
+// F1GameStation (miyoo_ver 8), all buttons active low:
+// UP PE10, DOWN PE11, LEFT PE4, RIGHT PE5, A PE7, B PE8, X PE9, Y PD12,
+// START PE12, SELECT PD0, MENU PA1, L PA2, R PA3.
+// PA1-PA3 have no pull-ups (the PIO pull bits do nothing on those TP pins),
+// so they are read by charging the line high and sensing it right after
+// switching to input: a pressed button pulls it low at once.
+#define F1GS_PA_MASK  ((1 << 1) | (1 << 2) | (1 << 3))
+#define F1GS_PD_MASK  ((1 << 0) | (1 << 12))
+#define F1GS_PE_MASK  ((1 << 4) | (1 << 5) | (1 << 7) | (1 << 8) | (1 << 9) | (1 << 10) | (1 << 11) | (1 << 12))
+#define F1GS_PA_DATA  (0 * 0x24 + 0x10)
+#define F1GS_PA_CFG0  (0 * 0x24 + 0x00)
+#define F1GS_PD_DATA  (3 * 0x24 + 0x10)
+#define F1GS_PE_DATA  (4 * 0x24 + 0x10)
+
 #define USE_UART	1
 
 #define NO_RAW	1
@@ -222,10 +238,92 @@ static void report_key(uint32_t btn, uint32_t mask, uint8_t key)
   }
 }
 
+static void f1gs_set_input(uint32_t port, uint32_t mask)
+{
+  uint32_t n, reg, ret;
+
+  for(n=0; n<32; n++){
+    if(mask & (1 << n)){
+      reg = port * 0x24 + (n / 8) * 4;
+      ret = readl(gpio + reg);
+      ret&= ~(0x0f << ((n % 8) * 4));
+      writel(ret, gpio + reg);
+    }
+  }
+}
+
+static void f1gs_set_pullup(uint32_t port, uint32_t mask)
+{
+  uint32_t n, reg, ret;
+
+  for(n=0; n<32; n++){
+    if(mask & (1 << n)){
+      reg = port * 0x24 + 0x1c + (n / 16) * 4;
+      ret = readl(gpio + reg);
+      ret&= ~(0x03 << ((n % 16) * 2));
+      ret|= (0x01 << ((n % 16) * 2));
+      writel(ret, gpio + reg);
+    }
+  }
+}
+
+static void f1gs_init(void)
+{
+  f1gs_set_input(4, F1GS_PE_MASK);
+  f1gs_set_pullup(4, F1GS_PE_MASK);
+  f1gs_set_input(3, F1GS_PD_MASK);
+  f1gs_set_pullup(3, F1GS_PD_MASK);
+  f1gs_set_input(0, F1GS_PA_MASK);
+}
+
+static uint32_t f1gs_read_pa(void)
+{
+  uint32_t ret, cfg;
+  unsigned long flags;
+
+  local_irq_save(flags);
+  writel(readl(gpio + F1GS_PA_DATA) | F1GS_PA_MASK, gpio + F1GS_PA_DATA);
+  cfg = readl(gpio + F1GS_PA_CFG0) & ~0x0000fff0;
+  writel(cfg | 0x00001110, gpio + F1GS_PA_CFG0);
+  udelay(1);
+  writel(cfg, gpio + F1GS_PA_CFG0);
+  ret = readl(gpio + F1GS_PA_DATA);
+  local_irq_restore(flags);
+  return ret;
+}
+
+static uint32_t f1gs_scan(void)
+{
+  uint32_t pa, pd, pe, val=0;
+
+  pa = ~f1gs_read_pa();
+  pd = ~readl(gpio + F1GS_PD_DATA);
+  pe = ~readl(gpio + F1GS_PE_DATA);
+
+  if(pe & (1 << 10)) val|= MY_UP;
+  if(pe & (1 << 11)) val|= MY_DOWN;
+  if(pe & (1 << 4))  val|= MY_LEFT;
+  if(pe & (1 << 5))  val|= MY_RIGHT;
+  // MY_A/MY_B/MY_TA/MY_TB are the bottom/left/right/top face buttons
+  if(pe & (1 << 8))  val|= MY_A;
+  if(pd & (1 << 12)) val|= MY_B;
+  if(pe & (1 << 7))  val|= MY_TA;
+  if(pe & (1 << 9))  val|= MY_TB;
+  if(pe & (1 << 12)) val|= MY_START;
+  if(pd & (1 << 0))  val|= MY_SELECT;
+  if(pa & (1 << 1))  val|= MY_R;
+  if(pa & (1 << 2))  val|= MY_L1;
+  if(pa & (1 << 3))  val|= MY_R1;
+  return val;
+}
+
 static void scan_handler(struct timer_list *timer)
 {
   static uint32_t pre=0;
   uint32_t scan=0, val=0, debounce=0;
+  // keys already held when scanning starts are ignored until released,
+  // so a shorted switch cannot hold a key down forever
+  static uint32_t stuck=0xffffffff;
   static uint32_t touchRead=0, touchReadPrev=0;
   //extern void MIYOO_INCREASE_VOLUME(void);
   //extern void MIYOO_DECREASE_VOLUME(void);
@@ -550,6 +648,17 @@ static void scan_handler(struct timer_list *timer)
               val|= MY_R;
           }
           break; 
+      case 8:
+          val = f1gs_scan();
+          if(stuck == 0xffffffff){
+              stuck = val;
+              if(stuck){
+                  printk("miyoo_kbd: ignoring keys held at start: 0x%x\n", stuck);
+              }
+          }
+          stuck&= val;
+          val&= ~stuck;
+          break;
   }
 
   if(lockkey){
@@ -557,7 +666,7 @@ static void scan_handler(struct timer_list *timer)
   }
 
 #if !defined(RAW)
-  if(miyoo_ver == 2)  {
+  if(miyoo_ver == 2 || miyoo_ver == 8)  {
     if((val & MY_R) && (val & MY_B)) {
       val&= ~MY_R;
       val&= ~MY_B;
@@ -756,7 +865,7 @@ static void scan_handler(struct timer_list *timer)
       }
 	 	}
 	 	else if((val & MY_R) && (val & MY_A)){
-      if(miyoo_ver == 2 || miyoo_ver == 3 || miyoo_ver == 5 || miyoo_ver == 6)  {
+      if(miyoo_ver == 2 || miyoo_ver == 3 || miyoo_ver == 5 || miyoo_ver == 6 || miyoo_ver == 8)  {
 	  	  hotkey_actioned = true;
       //  if (hotkey_custom)
 	  	    hotkey = hotkey == 0 ? 4 : hotkey;
@@ -770,7 +879,7 @@ static void scan_handler(struct timer_list *timer)
       }
 		}
 		else if((val & MY_R) && (val & MY_TA)){
-      if(miyoo_ver == 2 || miyoo_ver == 3 || miyoo_ver == 5 || miyoo_ver == 6)  {
+      if(miyoo_ver == 2 || miyoo_ver == 3 || miyoo_ver == 5 || miyoo_ver == 6 || miyoo_ver == 8)  {
         hotkey_actioned = true;
       //  if (hotkey_custom)
           hotkey = hotkey == 0 ? 2 : hotkey;
@@ -1000,6 +1109,11 @@ static int __init kbd_init(void)
   // datasheet: https://linux-sunxi.org/images/8/85/Allwinner_F1C600_User_Manual_V1.0.pdf
   // pages 116 onwards
   gpio = ioremap(0x01c20800, 4096);      // PIO block
+  if (miyoo_ver == 8) {
+    // leave PC (SPI flash) and PE0/PE1 (UART0) alone
+    f1gs_init();
+    goto register_input;
+  }
   ret = readl(gpio + (2 * 0x24 + 0x00)); // PC_CFG0
   ret&= 0xffff0000;                      // set (PC0?) PC1 PC2 PC3 as inputs
   writel(ret, gpio + (2 * 0x24 + 0x00)); // (somewhat dirty, writes into some reserved)
@@ -1067,6 +1181,7 @@ static int __init kbd_init(void)
 #endif
   do_output_request(OUT_2, "gpio_pe8");
   do_output_request(OUT_3, "gpio_pe9");
+register_input:
