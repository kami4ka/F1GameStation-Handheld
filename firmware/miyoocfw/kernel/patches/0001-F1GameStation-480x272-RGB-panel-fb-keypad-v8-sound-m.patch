diff --git a/drivers/video/fbdev/rgb480x272fb.c b/drivers/video/fbdev/rgb480x272fb.c
new file mode 100644
index 000000000..50418137f
--- /dev/null
+++ b/drivers/video/fbdev/rgb480x272fb.c
@@ -0,0 +1,586 @@
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option)any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ *
+ * Framebuffer driver for a 480x272 parallel RGB (HV sync + DE) panel on
+ * TCON0, as used on the F1GameStation board. The panel is refreshed by the
+ * TCON continuously, so no panel controller init is needed. MiyooCFW
+ * software draws a 320x240 RGB565 frame; DEBE layer 0 shows it centred on
+ * the 480x272 output with a black border.
+ *
+ * Timings were measured on the board during bring-up:
+ *   PLL_VIDEO 198 MHz, DCLK = 198 / 22 = 9 MHz,
+ *   HT 535, HBP 47, HSPW 4, VT 292, VBP 16, VSPW 4 (~57.6 Hz).
+ */
+
+#include <linux/cdev.h>
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/fb.h>
+#include <linux/dma-mapping.h>
+#include <linux/device.h>
+#include <linux/platform_device.h>
+#include <linux/uaccess.h>
+#include <linux/pm_runtime.h>
+#include <linux/interrupt.h>
+#include <linux/wait.h>
+#include <linux/clk.h>
+#include <linux/console.h>
+#include <linux/slab.h>
+#include <linux/delay.h>
+#include <linux/of.h>
+#include <linux/clk-provider.h>
+#include <asm/io.h>
+#include <asm/arch-suniv/cpu.h>
+#include <asm/arch-suniv/gpio.h>
+#include <asm/arch-suniv/lcdc.h>
+#include <asm/arch-suniv/debe.h>
+#include <asm/arch-suniv/clock.h>
+#include <asm/arch-suniv/common.h>
+
+#define PALETTE_SIZE 256
+#define DRIVER_NAME  "rgb480x272-fb"
+#define MIYOO_FB0_PUT_OSD     _IOWR(0x100, 0, unsigned long)
+#define MIYOO_FB0_SET_MODE    _IOWR(0x101, 0, unsigned long)
+#define MIYOO_FB0_GET_VER     _IOWR(0x102, 0, unsigned long)
+
+#define PANEL_W      480
+#define PANEL_H      272
+#define FB_W         320
+#define FB_H         240
+#define FB_FRAMES    4
+#define FB_LINE      (FB_W * 2)
+#define FB_FRAME     (FB_LINE * FB_H)
+
+static uint32_t version=1;
+module_param(version,uint,0660);
+MODULE_PARM_DESC(version, "Value returned by MIYOO_FB0_GET_VER");
+
+struct myfb_par {
+    struct device *dev;
+    struct platform_device *pdev;
+
+    resource_size_t p_palette_base;
+    unsigned short *v_palette_base;
+
+    int yoffset;
+    void *vram_virt;
+    uint32_t vram_size;
+    dma_addr_t vram_phys;
+
+    int bpp;
+    int lcdc_irq;
+    uint32_t vsync_count;
+    u32 pseudo_palette[16];
+    struct fb_videomode mode;
+};
+
+struct suniv_iomm {
+    uint8_t *ccm;
+    uint8_t *gpio;
+    uint8_t *lcdc;
+    uint8_t *debe;
+};
+static int major = -1;
+static struct cdev mycdev;
+static struct class *myclass = NULL;
+static struct suniv_iomm iomm={0};
+static struct myfb_par *mypar=NULL;
+static struct fb_var_screeninfo myfb_var={0};
+static DECLARE_WAIT_QUEUE_HEAD(wait_vsync_queue);
+
+static struct fb_fix_screeninfo myfb_fix = {
+        .id = DRIVER_NAME,
+        .type = FB_TYPE_PACKED_PIXELS,
+        .type_aux = 0,
+        .visual = FB_VISUAL_TRUECOLOR,
+        .xpanstep = 0,
+        .ypanstep = 1,
+        .ywrapstep = 0,
+        .accel = FB_ACCEL_NONE
+};
+
+// PD1-PD11 and PD13-PD21 are LCD (function 2). PD0 (SELECT) and PD12 (Y)
+// are buttons, so their nibbles are left alone.
+static void suniv_gpio_init(void)
+{
+    uint32_t r=0;
+
+    r = readl(iomm.gpio + PD_CFG0);
+    r&= 0x0000000f;
+    r|= 0x22222220;
+    writel(r, iomm.gpio + PD_CFG0);
+
+    r = readl(iomm.gpio + PD_CFG1);
+    r&= 0x000f0000;
+    r|= 0x22202222;
+    writel(r, iomm.gpio + PD_CFG1);
+
+    r = readl(iomm.gpio + PD_CFG2);
+    r&= 0xff000000;
+    r|= 0x00222222;
+    writel(r, iomm.gpio + PD_CFG2);
+}
+
+static void debe_set_frame(struct myfb_par *par)
+{
+    uint32_t addr = par->vram_phys + par->yoffset * FB_LINE;
+
+    writel(addr << 3, iomm.debe + DEBE_LAY0_FB_ADDR_REG);
+    writel(addr >> 29, iomm.debe + DEBE_LAY0_FB_HI_ADDR_REG);
+    // latched by the DEBE at the next frame start
+    suniv_setbits(iomm.debe + DEBE_REGBUFF_CTRL_REG, (1 << 0));
+}
+
+static irqreturn_t lcdc_irq_handler(int irq, void *arg)
+{
+    struct myfb_par *par = arg;
+
+    if((readl(iomm.lcdc + TCON_INT_REG0) & (1 << 15)) == 0){
+        return IRQ_NONE;
+    }
+    suniv_clrbits(iomm.lcdc + TCON_INT_REG0, (1 << 15));
+    par->vsync_count++;
+    wake_up_interruptible_all(&wait_vsync_queue);
+    return IRQ_HANDLED;
+}
+
+static int wait_for_vsync(struct myfb_par *par)
+{
+    uint32_t count = par->vsync_count;
+    long t = wait_event_interruptible_timeout(wait_vsync_queue, count != par->vsync_count, HZ / 10);
+
+    if(t < 0){
+        return t;
+    }
+    return t == 0 ? -ETIMEDOUT : 0;
+}
+
+static void suniv_cpu_init(struct myfb_par *par)
+{
+    uint32_t i;
+
+    // PLL_VIDEO = 24 MHz * 33 / 4 = 198 MHz
+    writel(0x81002003, iomm.ccm + PLL_VIDEO_CTRL_REG);
+    while((readl(iomm.ccm + PLL_VIDEO_CTRL_REG) & (1 << 28)) == 0){}
+
+    suniv_setbits(iomm.ccm + DRAM_GATING_REG, (1 << 26));
+    writel((1 << 31), iomm.ccm + BE_CLK_REG);
+    writel((1 << 31), iomm.ccm + TCON_CLK_REG);
+    suniv_setbits(iomm.ccm + BUS_CLK_GATING_REG1, (1 << 12) | (1 << 4));
+    suniv_setbits(iomm.ccm + BUS_SOFT_RST_REG1, (1 << 12) | (1 << 4));
+    // DEBE registers hold random data after reset
+    for(i=0x0800; i<0x1000; i+=4){
+        writel(0, iomm.debe + i);
+    }
+}
+
+static void suniv_lcdc_init(struct myfb_par *par)
+{
+    writel(0, iomm.lcdc + TCON_CTRL_REG);
+    writel(0, iomm.lcdc + TCON_INT_REG0);
+    writel(0, iomm.lcdc + TCON_CLK_CTRL_REG);
+    writel(0xffffffff, iomm.lcdc + TCON0_IO_CTRL_REG1);
+    writel(0xffffffff, iomm.lcdc + TCON1_IO_CTRL_REG1);
+
+    suniv_setbits(iomm.debe + DEBE_MODE_CTRL_REG, (1 << 0));
+    writel(0, iomm.debe + DEBE_COLOR_CTRL_REG);
+    writel(((PANEL_H - 1) << 16) | (PANEL_W - 1), iomm.debe + DEBE_DISP_SIZE_REG);
+    writel(((FB_H - 1) << 16) | (FB_W - 1), iomm.debe + DEBE_LAY0_SIZE_REG);
+    writel((((PANEL_H - FB_H) / 2) << 16) | ((PANEL_W - FB_W) / 2), iomm.debe + DEBE_LAY0_CODNT_REG);
+    writel(FB_W << 4, iomm.debe + DEBE_LAY0_LINEWIDTH_REG);
+    writel((5 << 8), iomm.debe + DEBE_LAY0_ATT_CTRL_REG1);
+    debe_set_frame(par);
+    suniv_setbits(iomm.debe + DEBE_MODE_CTRL_REG, (1 << 8));
+    suniv_setbits(iomm.debe + DEBE_REGBUFF_CTRL_REG, (1 << 1));
+    suniv_setbits(iomm.debe + DEBE_REGBUFF_CTRL_REG, (1 << 0));
+    suniv_setbits(iomm.debe + DEBE_MODE_CTRL_REG, (1 << 1));
+
+    // HV mode, start delay 20, DCLK = PLL_VIDEO / 22
+    writel((1 << 31) | (20 << 4), iomm.lcdc + TCON0_CTRL_REG);
+    writel((0xf << 28) | (22 << 0), iomm.lcdc + TCON_CLK_CTRL_REG);
+    writel(((PANEL_W - 1) << 16) | (PANEL_H - 1), iomm.lcdc + TCON0_BASIC_TIMING_REG0);
+    writel(((535 - 1) << 16) | (47 - 1), iomm.lcdc + TCON0_BASIC_TIMING_REG1);
+    writel(((292 * 2) << 16) | (16 - 1), iomm.lcdc + TCON0_BASIC_TIMING_REG2);
+    writel(((4 - 1) << 16) | (4 - 1), iomm.lcdc + TCON0_BASIC_TIMING_REG3);
+    writel(0, iomm.lcdc + TCON0_HV_TIMING_REG);
+    writel(0, iomm.lcdc + TCON0_CPU_IF_REG);
+    writel(0, iomm.lcdc + TCON_FRM_CTRL_REG);
+    // DE active high, HSYNC/VSYNC active low, DCLK phase as measured
+    writel(0x13000000, iomm.lcdc + TCON0_IO_CTRL_REG0);
+    writel(0, iomm.lcdc + TCON0_IO_CTRL_REG1);
+
+    suniv_gpio_init();
+    suniv_setbits(iomm.lcdc + TCON_CTRL_REG, (1 << 31));
+    suniv_setbits(iomm.lcdc + TCON_INT_REG0, (1 << 31));
+}
+
+static void suniv_enable_irq(struct myfb_par *par)
+{
+    int ret=0;
+
+    par->lcdc_irq = platform_get_irq(par->pdev, 0);
+    if(par->lcdc_irq < 0){
+        printk("%s, failed to get irq number for lcdc irq\n", __func__);
+    }
+    else{
+        ret = request_irq(par->lcdc_irq, lcdc_irq_handler, IRQF_SHARED, "lcdc_irq", par);
+        if(ret){
+            printk("%s, failed to register lcdc interrupt(%d)\n", __func__, par->lcdc_irq);
+            par->lcdc_irq = -1;
+        }
+    }
+}
+
+#define CNVT_TOHW(val, width) ((((val) << (width)) + 0x7FFF - (val)) >> 16)
+static int myfb_setcolreg(unsigned regno, unsigned red, unsigned green, unsigned blue, unsigned transp, struct fb_info *info)
+{
+    if(regno >= 16){
+        return -EINVAL;
+    }
+    red = CNVT_TOHW(red, info->var.red.length);
+    blue = CNVT_TOHW(blue, info->var.blue.length);
+    green = CNVT_TOHW(green, info->var.green.length);
+    ((u32*)(info->pseudo_palette))[regno] = (red << info->var.red.offset) | (green << info->var.green.offset) | (blue << info->var.blue.offset);
+    return 0;
+}
+#undef CNVT_TOHW
+
+static int myfb_check_var(struct fb_var_screeninfo *var, struct fb_info *info)
+{
+    int bpp = var->bits_per_pixel >> 3;
+    struct myfb_par *par = info->par;
+    unsigned long line_size = var->xres_virtual * bpp;
+
+    if((var->xres != FB_W) || (var->yres != FB_H) || (var->bits_per_pixel != 16)){
+        return -EINVAL;
+    }
+
+    var->transp.offset = 0;
+    var->transp.length = 0;
+    var->red.offset = 11;
+    var->red.length = 5;
+    var->green.offset = 5;
+    var->green.length = 6;
+    var->blue.offset = 0;
+    var->blue.length = 5;
+    var->red.msb_right = 0;
+    var->green.msb_right = 0;
+    var->blue.msb_right = 0;
+    var->transp.msb_right = 0;
+    if(line_size * var->yres_virtual > par->vram_size){
+        var->yres_virtual = par->vram_size / line_size;
+    }
+    if(var->yres > var->yres_virtual){
+        var->yres = var->yres_virtual;
+    }
+    if(var->xres > var->xres_virtual){
+        var->xres = var->xres_virtual;
+    }
+    if(var->xres + var->xoffset > var->xres_virtual){
+        var->xoffset = var->xres_virtual - var->xres;
+    }
+    if(var->yres + var->yoffset > var->yres_virtual){
+        var->yoffset = var->yres_virtual - var->yres;
+    }
+    return 0;
+}
+
+static int myfb_set_par(struct fb_info *info)
+{
+    struct myfb_par *par = info->par;
+
+    fb_var_to_videomode(&par->mode, &info->var);
+    par->yoffset = info->var.yoffset;
+    par->bpp = info->var.bits_per_pixel;
+    info->fix.visual = FB_VISUAL_TRUECOLOR;
+    info->fix.line_length = (par->mode.xres * par->bpp) / 8;
+    writel((5 << 8), iomm.debe + DEBE_LAY0_ATT_CTRL_REG1);
+    debe_set_frame(par);
+    return 0;
+}
+
+static int myfb_ioctl(struct fb_info *info, unsigned int cmd, unsigned long arg)
+{
+    switch(cmd){
+        case FBIO_WAITFORVSYNC:
+            return wait_for_vsync(info->par);
+    }
+    return 0;
+}
+
+static int myfb_mmap(struct fb_info *info, struct vm_area_struct *vma)
+{
+    const unsigned long offset = vma->vm_pgoff << PAGE_SHIFT;
+    const unsigned long size = vma->vm_end - vma->vm_start;
+
+    if(offset + size > info->fix.smem_len){
+        return -EINVAL;
+    }
+
+    if(remap_pfn_range(vma, vma->vm_start, (info->fix.smem_start + offset) >> PAGE_SHIFT, size, vma->vm_page_prot)){
+        return -EAGAIN;
+    }
+    return 0;
+}
+
+static int myfb_pan_display(struct fb_var_screeninfo *var, struct fb_info *info)
+{
+    struct myfb_par *par = info->par;
+
+    if((var->xoffset != info->var.xoffset) || (var->yoffset != info->var.yoffset)){
+        info->var.xoffset = var->xoffset;
+        info->var.yoffset = var->yoffset;
+        par->yoffset = var->yoffset;
+        debe_set_frame(par);
+    }
+    return 0;
+}
+
+static struct fb_ops myfb_ops = {
+        .owner          = THIS_MODULE,
+        .fb_check_var   = myfb_check_var,
+        .fb_set_par     = myfb_set_par,
+        .fb_setcolreg   = myfb_setcolreg,
+        .fb_pan_display = myfb_pan_display,
+        .fb_ioctl       = myfb_ioctl,
+        .fb_mmap        = myfb_mmap,
+
+        .fb_fillrect  = sys_fillrect,
+        .fb_copyarea  = sys_copyarea,
+        .fb_imageblit = sys_imageblit,
+};
+
+static int myfb_probe(struct platform_device *device)
+{
+    int ret=0;
+    struct fb_info *info=NULL;
+    struct myfb_par *par=NULL;
+    struct fb_videomode *mode=NULL;
+
+    mode = devm_kzalloc(&device->dev, sizeof(struct fb_videomode), GFP_KERNEL);
+    if(mode == NULL){
+        return -ENOMEM;
+    }
+    mode->name = "320x240";
+    mode->xres = FB_W;
+    mode->yres = FB_H;
+    mode->vmode = FB_VMODE_NONINTERLACED;
+    pm_runtime_enable(&device->dev);
+    pm_runtime_get_sync(&device->dev);
+
+    info = framebuffer_alloc(sizeof(struct myfb_par), &device->dev);
+    if(!info){
+        return -ENOMEM;
+    }
+
+    par = info->par;
+    par->pdev = device;
+    par->dev = &device->dev;
+    par->bpp = 16;
+    fb_videomode_to_var(&myfb_var, mode);
+
+    par->vram_size = FB_FRAME * FB_FRAMES;
+    par->vram_virt = dma_alloc_coherent(par->dev, par->vram_size, (resource_size_t*)&par->vram_phys, GFP_KERNEL | GFP_DMA);
+    if(!par->vram_virt){
+        return -EINVAL;
+    }
+    memset(par->vram_virt, 0, par->vram_size);
+    info->screen_base = (char __iomem*)par->vram_virt;
+    myfb_fix.smem_start = par->vram_phys;
+    myfb_fix.smem_len = par->vram_size;
+    myfb_fix.line_length = FB_LINE;
+
+    par->v_palette_base = dma_alloc_coherent(par->dev, PALETTE_SIZE, (resource_size_t*)&par->p_palette_base, GFP_KERNEL | GFP_DMA);
+    if(!par->v_palette_base){
+        return -EINVAL;
+    }
+    memset(par->v_palette_base, 0, PALETTE_SIZE);
+    myfb_var.grayscale = 0;
+    myfb_var.bits_per_pixel = par->bpp;
+
+    info->flags = FBINFO_FLAG_DEFAULT;
+    info->fix = myfb_fix;
+    info->var = myfb_var;
+    info->fbops = &myfb_ops;
+    info->pseudo_palette = par->pseudo_palette;
+    info->fix.visual = (info->var.bits_per_pixel <= 8) ? FB_VISUAL_PSEUDOCOLOR : FB_VISUAL_TRUECOLOR;
+    ret = fb_alloc_cmap(&info->cmap, PALETTE_SIZE, 0);
+    if(ret){
+        return -EINVAL;
+    }
+    info->cmap.len = 32;
+
+    mypar = par;
+    for(ret=0; ret<of_clk_get_parent_count(device->dev.of_node); ret++){
+        clk_prepare_enable(of_clk_get(device->dev.of_node, ret));
+    }
+    suniv_cpu_init(par);
+    suniv_lcdc_init(par);
+    suniv_enable_irq(par);
+
+    myfb_var.activate = FB_ACTIVATE_FORCE;
+    fb_set_var(info, &myfb_var);
+    dev_set_drvdata(&device->dev, info);
+    if(register_framebuffer(info) < 0){
+        return -EINVAL;
+    }
+    fb_prepare_logo(info, 0);
+    fb_show_logo(info, 0);
+    return 0;
+}
+
+static int myfb_remove(struct platform_device *dev)
+{
+    struct fb_info *info = dev_get_drvdata(&dev->dev);
+    struct myfb_par *par;
+
+    if(info){
+        par = info->par;
+        suniv_clrbits(iomm.lcdc + TCON_INT_REG0, (1 << 31));
+        if(par->lcdc_irq >= 0){
+            free_irq(par->lcdc_irq, par);
+        }
+        suniv_clrbits(iomm.lcdc + TCON_CTRL_REG, (1 << 31));
+        unregister_framebuffer(info);
+        fb_dealloc_cmap(&info->cmap);
+        dma_free_coherent(par->dev, PALETTE_SIZE, par->v_palette_base, par->p_palette_base);
+        dma_free_coherent(par->dev, par->vram_size, par->vram_virt, par->vram_phys);
+        pm_runtime_put_sync(&dev->dev);
+        pm_runtime_disable(&dev->dev);
+        framebuffer_release(info);
+    }
+    return 0;
+}
+
+static int myfb_suspend(struct platform_device *dev, pm_message_t state)
+{
+    struct fb_info *info = platform_get_drvdata(dev);
+
+    console_lock();
+    fb_set_suspend(info, 1);
+    pm_runtime_put_sync(&dev->dev);
+    console_unlock();
+    return 0;
+}
+
+static int myfb_resume(struct platform_device *dev)
+{
+    struct fb_info *info = platform_get_drvdata(dev);
+
+    console_lock();
+    pm_runtime_get_sync(&dev->dev);
+    fb_set_suspend(info, 0);
+    console_unlock();
+    return 0;
+}
+
+static const struct of_device_id fb_of_match[] = {
+        {
+                .compatible = "allwinner,suniv-f1c100s-tcon0",
+        },{}
+};
+MODULE_DEVICE_TABLE(of, fb_of_match);
+
+static struct platform_driver fb_driver = {
+        .probe    = myfb_probe,
+        .remove   = myfb_remove,
+        .suspend  = myfb_suspend,
+        .resume   = myfb_resume,
+        .driver = {
+                .name   = DRIVER_NAME,
+                .owner  = THIS_MODULE,
+                .of_match_table = of_match_ptr(fb_of_match),
+        },
+};
+
+static void suniv_ioremap(void)
+{
+    iomm.ccm = (uint8_t*)ioremap(SUNIV_CCM_BASE, 4096);
+    iomm.gpio = (uint8_t*)ioremap(SUNIV_GPIO_BASE, 4096);
+    iomm.lcdc = (uint8_t*)ioremap(SUNIV_LCDC_BASE, 4096);
+    iomm.debe = (uint8_t*)ioremap(SUNIV_DEBE_BASE, 4096);
+}
+
+static void suniv_iounmap(void)
+{
+    iounmap(iomm.ccm);
+    iounmap(iomm.gpio);
+    iounmap(iomm.lcdc);
+    iounmap(iomm.debe);
+}
+
+static int myopen(struct inode *inode, struct file *file)
+{
+    return 0;
+}
+
+static int myclose(struct inode *inode, struct file *file)
+{
+    return 0;
+}
+
+static long myioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+    int32_t bpp, ret;
+
+    switch(cmd){
+        case MIYOO_FB0_PUT_OSD:
+            break;
+        case MIYOO_FB0_SET_MODE:
+            // same layer formats as the other MiyooCFW panel drivers
+            bpp = (arg & 0xffff);
+            if(bpp != 16){
+                writel((5 << 8), iomm.debe + DEBE_LAY0_ATT_CTRL_REG1);
+            }
+            else{
+                writel((7 << 8) | 4, iomm.debe + DEBE_LAY0_ATT_CTRL_REG1);
+            }
+            break;
+        case MIYOO_FB0_GET_VER:
+            ret = copy_to_user((void*)arg, &version, sizeof(uint32_t));
+            break;
+    }
+    return 0;
+}
+
+static const struct file_operations myfops = {
+        .owner = THIS_MODULE,
+        .open = myopen,
+        .release = myclose,
+        .unlocked_ioctl = myioctl,
+};
+
+static int __init fb_init(void)
+{
+    alloc_chrdev_region(&major, 0, 1, "miyoo_fb0");
+    myclass = class_create(THIS_MODULE, "miyoo_fb0");
+    device_create(myclass, NULL, major, NULL, "miyoo_fb0");
+    cdev_init(&mycdev, &myfops);
+    cdev_add(&mycdev, major, 1);
+    suniv_ioremap();
+    return platform_driver_register(&fb_driver);
+}
+
+static void __exit fb_cleanup(void)
+{
+    platform_driver_unregister(&fb_driver);
+    suniv_iounmap();
+    device_destroy(myclass, major);
+    cdev_del(&mycdev);
+    class_destroy(myclass);
+    unregister_chrdev_region(major, 1);
+}
+
+module_init(fb_init);
+module_exit(fb_cleanup);
+
+MODULE_DESCRIPTION("Framebuffer driver for 480x272 RGB panels (320x240 centred)");
+MODULE_LICENSE("GPL");
